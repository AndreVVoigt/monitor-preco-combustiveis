    {
      "name": "analise_precos",
      "displayName": "Análise de Preços (sem GLP)",
      "queryLines": [
        "SELECT\n",
        "  t.data_referencia,\n",
        "  t.ano,\n",
        "  t.mes,\n",
        "  t.nome_mes,\n",
        "  l.regiao,\n",
        "  l.estado,\n",
        "  l.municipio,\n",
        "  p.produto,\n",
        "  f.tipo_pesquisa,\n",
        "  f.numero_postos_pesquisados,\n",
        "  f.preco_medio_revenda,\n",
        "  f.desvio_padrao_revenda,\n",
        "  f.preco_minimo_revenda,\n",
        "  f.preco_maximo_revenda,\n",
        "  f.coef_variacao_revenda\n",
        "FROM\n",
        "  fact_precos_combustiveis f\n",
        "    INNER JOIN dim_tempo t\n",
        "      ON f.id_tempo = t.id_tempo\n",
        "    INNER JOIN dim_localidade l\n",
        "      ON f.id_localidade = l.id_localidade\n",
        "    INNER JOIN dim_produto p\n",
        "      ON f.id_produto = p.id_produto\n",
        "WHERE\n",
        "  p.produto != 'GLP'"
      ],
      "catalog": "projeto_combustiveis",
      "schema": "gold"
    }
  ],
